{
    "database": {
        "type": "postgres",
        "schema": "/opt/engine-framework/env",
        "host": "postgres",
        "port": 5432,
        "username": "postgres",
        "database": "engine_framework_test"
    },
    "messenger": {
        "type": "redis",
        "host": "redis",
        "port": 6379
    },
    "queue": {
        "client": {
            "host": "redis",
            "port": 6379
        }
    },
    "runner": {
        "engines": [],
        "pool": "cpu"
    },
    "security": {
        "accessKeyId": "engine",
        "secretAccessKey": "password",
        "jwt": {
            "publicKey": "/opt/engine-framework/support/certs/localhost.crt",
            "privateKey": "/opt/engine-framework/support/certs/localhost.key"
        }
    },
    "sources": {},
    "storage": {
        "type": "s3",
        "name": "data",
        "config": {
            "accessKeyId": "S3_ACCESS_KEY_ID",
            "secretAccessKey": "S3_ACCESS_KEY_SECRET",
            "region": "us-east-1",
            "sslEnabled": false
        },
        "client": {
            "endpoint": "http://minio:9000",
            "s3ForcePathStyle": true,
            "sslEnabled": false,
            "bucket": "engine-framework-test"
        }
    }
}
